# LearningOps — API Keys
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# The .env file is in .gitignore.

# ─── Anthropic / Claude ──────────────────────────────────────────────────────
# Required for: Claude Code CLI, browser UI via Anthropic backend
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── OpenAI / Codex ──────────────────────────────────────────────────────────
# Required for: Codex CLI, browser UI via OpenAI backend
OPENAI_API_KEY=your_openai_api_key_here

# ─── Model override ───────────────────────────────────────────────────────────
# Optional. Overrides the model set in config/settings.yml.
# Leave blank to use settings.yml value.
# LEARNINGOPS_MODEL=claude-sonnet-4-6

# ─── Browser UI ───────────────────────────────────────────────────────────────
# Port for the local backend server (browser UI only)
# Must match config/settings.yml → api.port
LEARNINGOPS_PORT=3000

# ─── LLM provider for browser UI ─────────────────────────────────────────────
# Options: anthropic | openai
# Determines which API key the backend uses
LEARNINGOPS_PROVIDER=anthropic
